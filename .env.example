# Supabase (Free tier: 500MB DB, 50K MAU)
# Get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (server-side only, never expose to client)
# Get from Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials (for initial admin login)
NEXT_PUBLIC_ADMIN_EMAIL=admin@doonpresidency.edu.in
NEXT_PUBLIC_ADMIN_PASSWORD=ChangeThisPassword!
